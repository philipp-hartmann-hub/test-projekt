{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "public": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[[...path]]"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[[...path]].js": {
      "maxDuration": 30
    }
  }
}
